// The whole site: one Cloudflare Worker that serves the Jekyll build
// (site/_site) and runs the session API and the 10-minute cleanup.
//
// Nothing here is specific to one lab or account. The site reads its
// settings from the Cloudflare dashboard (Settings -> Variables and Secrets),
// and shows a setup page until the required ones are there. See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annotate",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "site/_site",
    "binding": "ASSETS",
    // Every request goes through the Worker first, so pages need a sign-in too.
    "run_worker_first": true
  },
  // Created on the first deploy; the Worker makes its own tables.
  "d1_databases": [{ "binding": "DB", "database_name": "annotate" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // Served at https://annotate.<your-subdomain>.workers.dev. The site signs
  // everyone in itself, so this address is as protected as a custom domain.
  "workers_dev": true,
  "preview_urls": false,
  // Settings live in the dashboard; deploys must not wipe them.
  "keep_vars": true
}
