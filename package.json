{
  "name": "annotate-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd site && bundle config set --local path vendor/bundle && bundle install --quiet && bundle exec jekyll build",
    "dev": "wrangler dev --test-scheduled --var BACKEND:mock",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc",
    "test": "node --no-warnings=ExperimentalWarning --test worker/test/*.test.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  }
}
