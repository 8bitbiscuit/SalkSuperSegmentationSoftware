[Unit]
Description=Cloudflare Tunnel to this desktop's DCV web client
Wants=network-online.target
After=network-online.target

[Service]
# TUNNEL_TOKEN, which cloudflared reads from the environment.
EnvironmentFile=/etc/annotate/secrets.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5s
