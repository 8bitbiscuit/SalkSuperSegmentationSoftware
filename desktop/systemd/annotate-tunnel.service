[Unit]
Description=Cloudflare Tunnel to this desktop's DCV web client
Wants=network-online.target
After=network-online.target

[Service]
# SITE_URL and SESSION_ID; TUNNEL_TOKEN (empty without a domain) and DESKTOP_KEY.
EnvironmentFile=/etc/annotate/session.env
EnvironmentFile=/etc/annotate/secrets.env
ExecStart=/opt/annotate/start-tunnel.sh
Restart=on-failure
RestartSec=5s
